<bpmndi:BPMNShape id="bd_review_draft_di" bpmnElement="bd_review_draft"><dc:Bounds x="395" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bd_review_draft_gw_di" bpmnElement="bd_review_draft_gw"><dc:Bounds x="590" y="95" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bd_review_draft_reject_end_di" bpmnElement="bd_review_draft_reject_end"><dc:Bounds x="762" y="382" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bd_review_draft_archive_end_di" bpmnElement="bd_review_draft_archive_end"><dc:Bounds x="762" y="522" width="36" height="36" /></bpmndi:BPMNShape>
