<bpmndi:BPMNShape id="bd_approve_details_gw_di" bpmnElement="bd_approve_details_gw"><dc:Bounds x="1085" y="235" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bd_approve_details_reject_end_di" bpmnElement="bd_approve_details_reject_end"><dc:Bounds x="1257" y="382" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bd_approve_details_archive_end_di" bpmnElement="bd_approve_details_archive_end"><dc:Bounds x="1257" y="522" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="138" y="120" /><di:waypoint x="260" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="310" y="120" /><di:waypoint x="395" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="285" y="145" /><di:waypoint x="285" y="260" /><di:waypoint x="725" y="260" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="505" y="120" /><di:waypoint x="590" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="615" y="145" /><di:waypoint x="615" y="260" /><di:waypoint x="725" y="260" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f6_di" bpmnElement="f6"><di:waypoint x="615" y="145" /><di:waypoint x="615" y="400" /><di:waypoint x="762" y="400" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f7_di" bpmnElement="f7"><di:waypoint x="615" y="145" /><di:waypoint x="615" y="540" /><di:waypoint x="762" y="540" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f8_di" bpmnElement="f8"><di:waypoint x="835" y="260" /><di:waypoint x="890" y="260" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f9_di" bpmnElement="f9"><di:waypoint x="1000" y="260" /><di:waypoint x="1085" y="260" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f10_di" bpmnElement="f10"><di:waypoint x="1135" y="260" /><di:waypoint x="1257" y="260" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f11_di" bpmnElement="f11"><di:waypoint x="1110" y="235" /><di:waypoint x="1110" y="202" /><di:waypoint x="780" y="202" /><di:waypoint x="780" y="220" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f12_di" bpmnElement="f12"><di:waypoint x="1110" y="285" /><di:waypoint x="1110" y="400" /><di:waypoint x="1257" y="400" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f13_di" bpmnElement="f13"><di:waypoint x="1110" y="285" /><di:waypoint x="1110" y="540" /><di:waypoint x="1257" y="540" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
