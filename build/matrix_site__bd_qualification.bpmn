<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_matrix_site__bd_qualification" targetNamespace="https://matrix-bd/workflow">
<bpmn:error id="Error_CLOSED" name="CLOSED" errorCode="CLOSED" />
<bpmn:process id="matrix_site__bd_qualification" name="BD - Site qualification" isExecutable="true" operaton:historyTimeToLive="180" operaton:isStartableInTasklist="false">
<bpmn:startEvent id="start" name="Start"></bpmn:startEvent>
<bpmn:endEvent id="done" name="Done"></bpmn:endEvent>
<bpmn:exclusiveGateway id="bd_review_draft_skip" name="Skip?" />
<bpmn:userTask id="bd_review_draft" name="Review site draft" operaton:formKey="embedded:deployment:forms/bd_review_draft.html" operaton:candidateGroups="bdSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="bd_review_draft_gw" />
<bpmn:endEvent id="bd_review_draft_reject_end" name="Closed"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:endEvent>
<bpmn:endEvent id="bd_review_draft_archive_end" name="Closed"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:endEvent>
<bpmn:userTask id="bd_site_details" name="Submit site details" operaton:formKey="embedded:deployment:forms/bd_site_details.html" operaton:assignee="${initiator}"></bpmn:userTask>
<bpmn:userTask id="bd_approve_details" name="Approve site details" operaton:formKey="embedded:deployment:forms/bd_approve_details.html" operaton:candidateGroups="bdSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="bd_approve_details_gw" />
<bpmn:endEvent id="bd_approve_details_reject_end" name="Closed"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:endEvent>
<bpmn:endEvent id="bd_approve_details_archive_end" name="Closed"><bpmn:errorEventDefinition errorRef="Error_CLOSED" /></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="bd_review_draft_skip" />
<bpmn:sequenceFlow id="f2" sourceRef="bd_review_draft_skip" targetRef="bd_review_draft"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!(execution.processEngineServices.identityService.createGroupQuery().groupMember(initiator).groupId('bdSupervisor').count() &gt; 0)}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f3" sourceRef="bd_review_draft_skip" targetRef="bd_site_details" name="Skip"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.processEngineServices.identityService.createGroupQuery().groupMember(initiator).groupId('bdSupervisor').count() &gt; 0}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f4" sourceRef="bd_review_draft" targetRef="bd_review_draft_gw" />
<bpmn:sequenceFlow id="f5" sourceRef="bd_review_draft_gw" targetRef="bd_site_details" name="Shortlist"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_review_draft_outcome == 'shortlist'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="bd_review_draft_gw" targetRef="bd_review_draft_reject_end" name="Reject"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_review_draft_outcome == 'reject'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" sourceRef="bd_review_draft_gw" targetRef="bd_review_draft_archive_end" name="Archive"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_review_draft_outcome == 'archive'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f8" sourceRef="bd_site_details" targetRef="bd_approve_details" />
<bpmn:sequenceFlow id="f9" sourceRef="bd_approve_details" targetRef="bd_approve_details_gw" />
<bpmn:sequenceFlow id="f10" sourceRef="bd_approve_details_gw" targetRef="done" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_approve_details_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f11" sourceRef="bd_approve_details_gw" targetRef="bd_site_details" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_approve_details_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f12" sourceRef="bd_approve_details_gw" targetRef="bd_approve_details_reject_end" name="Reject"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_approve_details_outcome == 'reject'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f13" sourceRef="bd_approve_details_gw" targetRef="bd_approve_details_archive_end" name="Archive"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${bd_approve_details_outcome == 'archive'}</bpmn:conditionExpression></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_matrix_site__bd_qualification"><bpmndi:BPMNPlane id="plane_matrix_site__bd_qualification" bpmnElement="matrix_site__bd_qualification">
<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="102" y="102" width="36" height="36" /></bpmndi:BPMNShape>
