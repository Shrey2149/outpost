<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_matrix_site__design" targetNamespace="https://matrix-bd/workflow">
<bpmn:process id="matrix_site__design" name="Design" isExecutable="true" operaton:historyTimeToLive="180" operaton:isStartableInTasklist="false">
<bpmn:startEvent id="start" name="Start"></bpmn:startEvent>
<bpmn:endEvent id="done" name="Done"></bpmn:endEvent>
<bpmn:userTask id="design_allocate" name="Allocate design executive" operaton:formKey="embedded:deployment:forms/design_allocate.html" operaton:candidateGroups="designSupervisor"></bpmn:userTask>
<bpmn:userTask id="design_recce" name="Upload recce" operaton:formKey="embedded:deployment:forms/design_recce.html" operaton:assignee="${designExec}"></bpmn:userTask>
<bpmn:userTask id="design_recce_review" name="Review recce" operaton:formKey="embedded:deployment:forms/design_recce_review.html" operaton:candidateGroups="designSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_recce_review_gw" />
<bpmn:userTask id="design_2d" name="Upload 2D layout" operaton:formKey="embedded:deployment:forms/design_2d.html" operaton:assignee="${designExec}"></bpmn:userTask>
<bpmn:userTask id="design_2d_review" name="Review 2D" operaton:formKey="embedded:deployment:forms/design_2d_review.html" operaton:candidateGroups="designSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_2d_review_gw" />
<bpmn:userTask id="design_2d_admin" name="Admin approve 2D" operaton:formKey="embedded:deployment:forms/design_2d_admin.html" operaton:candidateGroups="businessAdmin"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_2d_admin_gw" />
<bpmn:userTask id="design_3d" name="Upload 3D" operaton:formKey="embedded:deployment:forms/design_3d.html" operaton:assignee="${designExec}"></bpmn:userTask>
<bpmn:userTask id="design_3d_review" name="Review 3D" operaton:formKey="embedded:deployment:forms/design_3d_review.html" operaton:candidateGroups="designSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_3d_review_gw" />
<bpmn:userTask id="design_gfc" name="GFC approval (Good For Construction)" operaton:formKey="embedded:deployment:forms/design_gfc.html" operaton:candidateGroups="businessAdmin"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_gfc_gw" />
<bpmn:userTask id="design_boq" name="Upload BOQ and estimate" operaton:formKey="embedded:deployment:forms/design_boq.html" operaton:assignee="${designExec}"></bpmn:userTask>
<bpmn:userTask id="design_boq_review" name="Review BOQ" operaton:formKey="embedded:deployment:forms/design_boq_review.html" operaton:candidateGroups="designSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_boq_review_gw" />
<bpmn:userTask id="design_final" name="Approve design completion" operaton:formKey="embedded:deployment:forms/design_final.html" operaton:candidateGroups="businessAdmin"></bpmn:userTask>
<bpmn:exclusiveGateway id="design_final_gw" />
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="design_allocate" />
<bpmn:sequenceFlow id="f2" sourceRef="design_allocate" targetRef="design_recce" />
<bpmn:sequenceFlow id="f3" sourceRef="design_recce" targetRef="design_recce_review" />
<bpmn:sequenceFlow id="f4" sourceRef="design_recce_review" targetRef="design_recce_review_gw" />
<bpmn:sequenceFlow id="f5" sourceRef="design_recce_review_gw" targetRef="design_2d" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_recce_review_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="design_recce_review_gw" targetRef="design_recce" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_recce_review_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f7" sourceRef="design_2d" targetRef="design_2d_review" />
<bpmn:sequenceFlow id="f8" sourceRef="design_2d_review" targetRef="design_2d_review_gw" />
<bpmn:sequenceFlow id="f9" sourceRef="design_2d_review_gw" targetRef="design_2d_admin" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_2d_review_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f10" sourceRef="design_2d_review_gw" targetRef="design_2d" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_2d_review_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f11" sourceRef="design_2d_admin" targetRef="design_2d_admin_gw" />
<bpmn:sequenceFlow id="f12" sourceRef="design_2d_admin_gw" targetRef="design_3d" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_2d_admin_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f13" sourceRef="design_2d_admin_gw" targetRef="design_2d" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_2d_admin_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f14" sourceRef="design_3d" targetRef="design_3d_review" />
<bpmn:sequenceFlow id="f15" sourceRef="design_3d_review" targetRef="design_3d_review_gw" />
<bpmn:sequenceFlow id="f16" sourceRef="design_3d_review_gw" targetRef="design_gfc" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_3d_review_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f17" sourceRef="design_3d_review_gw" targetRef="design_3d" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_3d_review_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f18" sourceRef="design_gfc" targetRef="design_gfc_gw" />
<bpmn:sequenceFlow id="f19" sourceRef="design_gfc_gw" targetRef="design_boq" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_gfc_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f20" sourceRef="design_gfc_gw" targetRef="design_3d" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_gfc_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f21" sourceRef="design_boq" targetRef="design_boq_review" />
<bpmn:sequenceFlow id="f22" sourceRef="design_boq_review" targetRef="design_boq_review_gw" />
<bpmn:sequenceFlow id="f23" sourceRef="design_boq_review_gw" targetRef="design_final" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_boq_review_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f24" sourceRef="design_boq_review_gw" targetRef="design_boq" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_boq_review_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f25" sourceRef="design_final" targetRef="design_final_gw" />
<bpmn:sequenceFlow id="f26" sourceRef="design_final_gw" targetRef="done" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_final_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f27" sourceRef="design_final_gw" targetRef="design_boq" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${design_final_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_matrix_site__design"><bpmndi:BPMNPlane id="plane_matrix_site__design" bpmnElement="matrix_site__design">
