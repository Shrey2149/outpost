<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_matrix_site__nso" targetNamespace="https://matrix-bd/workflow">
<bpmn:process id="matrix_site__nso" name="NSO - Opening readiness" isExecutable="true" operaton:historyTimeToLive="180" operaton:isStartableInTasklist="false">
<bpmn:startEvent id="start" name="Start"></bpmn:startEvent>
<bpmn:endEvent id="done" name="Done"></bpmn:endEvent>
<bpmn:userTask id="nso_comms" name="Float launch communications" operaton:formKey="embedded:deployment:forms/nso_comms.html" operaton:candidateGroups="nsoExecutive"></bpmn:userTask>
<bpmn:userTask id="nso_readiness" name="Complete readiness checks" operaton:formKey="embedded:deployment:forms/nso_readiness.html" operaton:candidateGroups="nsoExecutive"></bpmn:userTask>
<bpmn:parallelGateway id="split2" />
<bpmn:parallelGateway id="join2" />
<bpmn:userTask id="nso_signoff" name="NSO sign-off" operaton:formKey="embedded:deployment:forms/nso_signoff.html" operaton:candidateGroups="nsoSupervisor"></bpmn:userTask>
<bpmn:userTask id="nso_project_signoff" name="Project sign-off for NSO" operaton:formKey="embedded:deployment:forms/nso_project_signoff.html" operaton:candidateGroups="projectSupervisor"></bpmn:userTask>
<bpmn:userTask id="nso_launch_ready" name="Final approval: launch ready" operaton:formKey="embedded:deployment:forms/nso_launch_ready.html" operaton:candidateGroups="nsoSupervisor"></bpmn:userTask>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="nso_comms" />
<bpmn:sequenceFlow id="f2" sourceRef="nso_comms" targetRef="nso_readiness" />
<bpmn:sequenceFlow id="f3" sourceRef="nso_readiness" targetRef="split2" />
<bpmn:sequenceFlow id="f4" sourceRef="split2" targetRef="nso_signoff" />
<bpmn:sequenceFlow id="f5" sourceRef="nso_signoff" targetRef="join2" />
<bpmn:sequenceFlow id="f6" sourceRef="split2" targetRef="nso_project_signoff" />
<bpmn:sequenceFlow id="f7" sourceRef="nso_project_signoff" targetRef="join2" />
<bpmn:sequenceFlow id="f8" sourceRef="join2" targetRef="nso_launch_ready" />
<bpmn:sequenceFlow id="f9" sourceRef="nso_launch_ready" targetRef="done" />
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_matrix_site__nso"><bpmndi:BPMNPlane id="plane_matrix_site__nso" bpmnElement="matrix_site__nso">
