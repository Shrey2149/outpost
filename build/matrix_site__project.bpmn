<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="defs_matrix_site__project" targetNamespace="https://matrix-bd/workflow">
<bpmn:process id="matrix_site__project" name="Project execution" isExecutable="true" operaton:historyTimeToLive="180" operaton:isStartableInTasklist="false">
<bpmn:startEvent id="start" name="Start"></bpmn:startEvent>
<bpmn:endEvent id="done" name="Done"></bpmn:endEvent>
<bpmn:userTask id="prj_allocate" name="Propose project initialization" operaton:formKey="embedded:deployment:forms/prj_allocate.html" operaton:candidateGroups="projectSupervisor"></bpmn:userTask>
<bpmn:userTask id="prj_accept" name="Accept project allocation" operaton:formKey="embedded:deployment:forms/prj_accept.html" operaton:assignee="${projectExec}"></bpmn:userTask>
<bpmn:exclusiveGateway id="prj_accept_gw" />
<bpmn:userTask id="prj_expected" name="Submit expected completion" operaton:formKey="embedded:deployment:forms/prj_expected.html" operaton:assignee="${projectExec}"></bpmn:userTask>
<bpmn:userTask id="prj_expected_review" name="Approve expected completion" operaton:formKey="embedded:deployment:forms/prj_expected_review.html" operaton:candidateGroups="projectSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="prj_expected_review_gw" />
<bpmn:userTask id="prj_mid_visit" name="Set mid-project visit" operaton:formKey="embedded:deployment:forms/prj_mid_visit.html" operaton:candidateGroups="projectSupervisor"></bpmn:userTask>
<bpmn:userTask id="prj_inspection" name="Submit inspection and quality audit" operaton:formKey="embedded:deployment:forms/prj_inspection.html" operaton:assignee="${projectExec}"></bpmn:userTask>
<bpmn:userTask id="prj_qa_review" name="Review quality audit" operaton:formKey="embedded:deployment:forms/prj_qa_review.html" operaton:candidateGroups="projectSupervisor"></bpmn:userTask>
<bpmn:exclusiveGateway id="prj_qa_review_gw" />
<bpmn:userTask id="prj_qa_signoff" name="Quality audit sign-off" operaton:formKey="embedded:deployment:forms/prj_qa_signoff.html" operaton:candidateGroups="businessAdmin"></bpmn:userTask>
<bpmn:exclusiveGateway id="prj_qa_signoff_gw" />
<bpmn:userTask id="prj_complete" name="Mark final completion" operaton:formKey="embedded:deployment:forms/prj_complete.html" operaton:assignee="${projectExec}"></bpmn:userTask>
<bpmn:userTask id="prj_push_nso" name="Push to NSO handover" operaton:formKey="embedded:deployment:forms/prj_push_nso.html" operaton:candidateGroups="projectSupervisor"></bpmn:userTask>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="prj_allocate" />
<bpmn:sequenceFlow id="f2" sourceRef="prj_allocate" targetRef="prj_accept" />
<bpmn:sequenceFlow id="f3" sourceRef="prj_accept" targetRef="prj_accept_gw" />
<bpmn:sequenceFlow id="f4" sourceRef="prj_accept_gw" targetRef="prj_expected" name="Accept"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_accept_outcome == 'accept'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f5" sourceRef="prj_accept_gw" targetRef="prj_allocate" name="Decline"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_accept_outcome == 'decline'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f6" sourceRef="prj_expected" targetRef="prj_expected_review" />
<bpmn:sequenceFlow id="f7" sourceRef="prj_expected_review" targetRef="prj_expected_review_gw" />
<bpmn:sequenceFlow id="f8" sourceRef="prj_expected_review_gw" targetRef="prj_mid_visit" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_expected_review_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f9" sourceRef="prj_expected_review_gw" targetRef="prj_expected" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_expected_review_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f10" sourceRef="prj_mid_visit" targetRef="prj_inspection" />
<bpmn:sequenceFlow id="f11" sourceRef="prj_inspection" targetRef="prj_qa_review" />
<bpmn:sequenceFlow id="f12" sourceRef="prj_qa_review" targetRef="prj_qa_review_gw" />
<bpmn:sequenceFlow id="f13" sourceRef="prj_qa_review_gw" targetRef="prj_qa_signoff" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_qa_review_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f14" sourceRef="prj_qa_review_gw" targetRef="prj_inspection" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_qa_review_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f15" sourceRef="prj_qa_signoff" targetRef="prj_qa_signoff_gw" />
<bpmn:sequenceFlow id="f16" sourceRef="prj_qa_signoff_gw" targetRef="prj_complete" name="Approve"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_qa_signoff_outcome == 'approve'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f17" sourceRef="prj_qa_signoff_gw" targetRef="prj_inspection" name="Send back"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${prj_qa_signoff_outcome == 'send_back'}</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="f18" sourceRef="prj_complete" targetRef="prj_push_nso" />
<bpmn:sequenceFlow id="f19" sourceRef="prj_push_nso" targetRef="done" />
</bpmn:process>
<bpmndi:BPMNDiagram id="dia_matrix_site__project"><bpmndi:BPMNPlane id="plane_matrix_site__project" bpmnElement="matrix_site__project">
<bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="102" y="102" width="36" height="36" /></bpmndi:BPMNShape>
