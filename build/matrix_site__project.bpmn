<bpmndi:BPMNShape id="prj_mid_visit_di" bpmnElement="prj_mid_visit"><dc:Bounds x="1220" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_inspection_di" bpmnElement="prj_inspection"><dc:Bounds x="1385" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_qa_review_di" bpmnElement="prj_qa_review"><dc:Bounds x="1550" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_qa_review_gw_di" bpmnElement="prj_qa_review_gw"><dc:Bounds x="1745" y="95" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_qa_signoff_di" bpmnElement="prj_qa_signoff"><dc:Bounds x="1880" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_qa_signoff_gw_di" bpmnElement="prj_qa_signoff_gw"><dc:Bounds x="2075" y="95" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_complete_di" bpmnElement="prj_complete"><dc:Bounds x="2210" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="prj_push_nso_di" bpmnElement="prj_push_nso"><dc:Bounds x="2375" y="80" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="138" y="120" /><di:waypoint x="230" y="120" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="340" y="120" /><di:waypoint x="395" y="120" /></bpmndi:BPMNEdge>
